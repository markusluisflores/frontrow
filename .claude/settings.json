{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(gitleaks *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/spotless-file.ps1",
            "statusMessage": "Formatting Java file..."
          }
        ]
      }
    ]
  }
}
